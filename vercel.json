{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!api/|@|src/|node_modules/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/customers/admin?action=reconcile&maxPages=2",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/campaigns?action=runBatch&batchSize=5",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/campaigns?action=reconcile&limit=25",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/admin?resource=actions&action=generate",
      "schedule": "15 4 * * *"
    }
  ]
}
